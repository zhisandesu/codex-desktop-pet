<Window x:Class="XiaobianPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="柯朵"
        Width="326.7"
        Height="372.6"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewMouseMove="Window_PreviewMouseMove"
        MouseLeave="Window_MouseLeave"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        LostMouseCapture="Window_LostMouseCapture">
  <Window.Resources>
    <Style x:Key="MoonSubmenuItemStyle"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource MoonMenuItemStyle}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type MenuItem}">
            <Grid>
              <Border x:Name="Chrome"
                      Padding="{TemplateBinding Padding}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="Transparent"
                      BorderThickness="1"
                      CornerRadius="11"
                      SnapsToDevicePixels="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ContentSource="Icon" />
                  <ContentPresenter Grid.Column="1"
                                    Margin="7,0,10,0"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                  <TextBlock Grid.Column="2"
                             VerticalAlignment="Center"
                             FontFamily="Segoe Fluent Icons"
                             FontSize="11"
                             Foreground="{StaticResource MoonMutedBrush}"
                             Text="&#xE76C;" />
                </Grid>
              </Border>

              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     Focusable="False"
                     HorizontalOffset="-2"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     Placement="Right"
                     PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                     PopupAnimation="Fade"
                     VerticalOffset="-8">
                <Border MinWidth="178"
                        Margin="8"
                        Padding="4"
                        Background="{StaticResource MoonTransientBrush}"
                        BorderBrush="{StaticResource MoonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Opacity="0.18"
                                      Color="#FF413955" />
                  </Border.Effect>
                  <ScrollViewer CanContentScroll="True"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MoonLavenderHoverBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource MoonSoftBorderBrush}" />
              </Trigger>
              <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MoonLavenderSelectedBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource MoonBorderBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.46" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Window.ContextMenu>
    <ContextMenu FontFamily="Microsoft YaHei UI"
                 Placement="Right"
                 HorizontalOffset="10"
                 Style="{StaticResource MoonContextMenuStyle}">
      <MenuItem Focusable="False"
                IsHitTestVisible="False"
                StaysOpenOnClick="True"
                Style="{StaticResource MoonMenuHeaderItemStyle}">
        <MenuItem.Header>
          <Grid MinWidth="214" Margin="2,1,2,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="34"
                    Height="34"
                    CornerRadius="17"
                    Background="#FFF2EDFC"
                    BorderBrush="#B8C9BCE7"
                    BorderThickness="1">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="17"
                         Foreground="#FF74638F"
                         Text="&#xE734;" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="柯朵"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="#FF3F3650" />
              <TextBlock Margin="0,1,0,0"
                         Text="CODEX DESKTOP COMPANION"
                         FontFamily="Segoe UI"
                         FontSize="8.5"
                         Foreground="#FF9187A1" />
            </StackPanel>

            <Border Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="7,3"
                    VerticalAlignment="Center"
                    CornerRadius="9"
                    Background="#FFE9F7F0"
                    BorderBrush="#A8B8DFC9"
                    BorderThickness="1">
              <TextBlock Text="在线"
                         FontSize="9"
                         FontWeight="SemiBold"
                         Foreground="#FF3F8466" />
            </Border>
          </Grid>
        </MenuItem.Header>
      </MenuItem>

      <Separator Margin="12,3" Background="#62B8ABC9" />

      <MenuItem Header="打开聊天面板"
                Click="OpenPanelMenuItem_Click"
                Style="{StaticResource MoonMenuItemStyle}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE8A7;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="15"
                     Foreground="#FF74638F" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="和柯朵打招呼"
                Click="WaveMenuItem_Click"
                Style="{StaticResource MoonMenuItemStyle}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE8F2;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="15"
                     Foreground="#FF74638F" />
        </MenuItem.Icon>
      </MenuItem>

      <MenuItem Header="摸摸头"
                Click="HeadPatMenuItem_Click"
                ToolTip="也可以不按鼠标，在头部左右轻抚；按住左键仍为抓取"
                Style="{StaticResource MoonMenuItemStyle}" />
      <MenuItem Header="庆祝一下"
                Click="CelebrateMenuItem_Click"
                ToolTip="原地小握拳庆祝；不会抢占弹脑门或抓取动作"
                Style="{StaticResource MoonMenuItemStyle}" />
      <MenuItem Header="喂一根内存条"
                Click="RamNibbleMenuItem_Click"
                ToolTip="站着吃一小口卖萌；坐着时先完整站起来"
                Style="{StaticResource MoonMenuItemStyle}" />
      <MenuItem Header="看看回收站"
                Click="RecycleBinMenuItem_Click"
                ToolTip="只查看回收站数量，不读取文件内容，也不会清空或恢复文件"
                Style="{StaticResource MoonMenuItemStyle}" />

      <Separator Margin="12,3" Background="#62B8ABC9" />

      <MenuItem x:Name="TtsMenuItem"
                Header="语音播报"
                IsCheckable="True"
                Click="TtsMenuItem_Click"
                Style="{StaticResource MoonMenuItemStyle}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE767;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="15"
                     Foreground="#FF74638F" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem x:Name="TtsVoiceMenuItem"
                Header="方舟音色"
                Style="{StaticResource MoonSubmenuItemStyle}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE8D6;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="15"
                     Foreground="#FF74638F" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem x:Name="DynamicDialogueMenuItem"
                Header="Luna 动态角色台词"
                IsCheckable="True"
                ToolTip="通过本机 ChatGPT 登录的 Codex 使用 gpt-5.6-luna；不会读取 OpenAI API Key，连接不可用时自动使用本地台词。"
                Click="DynamicDialogueMenuItem_Click"
                Style="{StaticResource MoonMenuItemStyle}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE8BD;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="15"
                     Foreground="#FF74638F" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem x:Name="TaskContextFeedbackMenuItem"
                Header="任务情境反馈"
                IsCheckable="True"
                ToolTip="识别 Codex 中继续任务、改代码的事件，偶尔用气泡和语音回应；只在本地分类，不把代码或任务正文发给台词模型。"
                Click="TaskContextFeedbackMenuItem_Click"
                Style="{StaticResource MoonMenuItemStyle}" />
      <MenuItem x:Name="MemoryMenuItem"
                Header="柯朵记忆 · 0 条"
                Style="{StaticResource MoonSubmenuItemStyle}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE81C;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="15"
                     Foreground="#FF74638F" />
        </MenuItem.Icon>
        <MenuItem Header="查看记忆…"
                  Click="ViewMemoryMenuItem_Click"
                  Style="{StaticResource MoonMenuItemStyle}" />
        <MenuItem x:Name="ShareMemoryMenuItem"
                  Header="本地重点备份（房间记忆为主）"
                  IsCheckable="True"
                  ToolTip="常驻房间会自行保留并压缩上下文；开启后，程序再把重要偏好、事件与习惯保存为本地索引，方便查看和定向遗忘。"
                  Click="ShareMemoryMenuItem_Click"
                  Style="{StaticResource MoonMenuItemStyle}" />
        <Separator Margin="12,3" Background="#62B8ABC9" />
        <MenuItem Header="清空全部记忆…"
                  Click="ClearMemoryMenuItem_Click"
                  Style="{StaticResource MoonMenuItemStyle}" />
      </MenuItem>
      <MenuItem Header="外观设置…"
                Click="AppearanceSettingsMenuItem_Click"
                Style="{StaticResource MoonMenuItemStyle}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE713;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="15"
                     Foreground="#FF74638F" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="重新连接 Codex"
                Click="ReconnectMenuItem_Click"
                Style="{StaticResource MoonMenuItemStyle}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE72C;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="15"
                     Foreground="#FF74638F" />
        </MenuItem.Icon>
      </MenuItem>

      <Separator Margin="12,3" Background="#62B8ABC9" />

      <MenuItem Header="退出柯朵"
                Click="ExitMenuItem_Click"
                Style="{StaticResource MoonMenuItemStyle}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE7E8;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="15"
                     Foreground="#FFC6637A" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </Window.ContextMenu>

  <Grid Background="{x:Null}">
    <!-- For the selected pet size, keep the native window large enough for the
         biggest animation. Animations resize only this centered viewport. -->
    <Grid x:Name="PetViewport"
          Width="242"
          Height="276"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
      <Image x:Name="PetImage"
             Margin="7"
             Stretch="Uniform"
             RenderOptions.BitmapScalingMode="HighQuality"
             Cursor="Hand"
             ToolTip="单击触发互动动画；长按头、翅膀或身体片刻再拖动；双击打招呼；聊天请点角色旁的悬浮球"
             MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
             PreviewMouseRightButtonUp="PetImage_PreviewMouseRightButtonUp" />

      <Border x:Name="StatusBadge"
              MinWidth="94"
              MaxWidth="126"
              Height="28"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,10,8,0"
              Padding="9,3"
              CornerRadius="14"
              Background="#DEFFFDFE"
              BorderBrush="#A88C76D8"
              BorderThickness="1"
              IsHitTestVisible="False"
              Panel.ZIndex="3">
        <Border.Effect>
          <DropShadowEffect BlurRadius="13"
                            ShadowDepth="2"
                            Opacity="0.18"
                            Color="#796E5E8E" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FFB5ADCB" Margin="0,0,6,0" />
          <TextBlock x:Name="StatusText" Text="正在醒来" Foreground="{StaticResource InkBrush}" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
