<Application x:Class="XiaobianPet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- Compatibility palette used by the existing windows. -->
    <Color x:Key="InkColor">#FF2D2840</Color>
    <Color x:Key="LavenderColor">#FF8C76D8</Color>
    <Color x:Key="LavenderSoftColor">#FFF1EDFF</Color>
    <Color x:Key="MintColor">#FF65C9B1</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="LavenderBrush" Color="{StaticResource LavenderColor}" />
    <SolidColorBrush x:Key="LavenderSoftBrush" Color="{StaticResource LavenderSoftColor}" />
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />

    <!-- The shell is intentionally more transparent than its inner cards.
         Text and controls remain fully opaque on layered WPF windows. -->
    <SolidColorBrush x:Key="MoonShellBrush" Color="#DEFBFAFF" />
    <SolidColorBrush x:Key="MoonTransientBrush" Color="#D8F8F6FF" />
    <SolidColorBrush x:Key="MoonCardBrush" Color="#E8FFFFFF" />
    <SolidColorBrush x:Key="MoonSubtleBrush" Color="#DDF5F2FA" />
    <SolidColorBrush x:Key="MoonBorderBrush" Color="#A88C76D8" />
    <SolidColorBrush x:Key="MoonMutedBrush" Color="#FF686276" />
    <SolidColorBrush x:Key="MoonAmberBrush" Color="#FFE2A348" />
    <SolidColorBrush x:Key="MoonDangerBrush" Color="#FFD96A79" />

    <SolidColorBrush x:Key="MoonLavenderHoverBrush" Color="#26998BE4" />
    <SolidColorBrush x:Key="MoonLavenderSelectedBrush" Color="#338C76D8" />
    <SolidColorBrush x:Key="MoonLavenderPressedBrush" Color="#FF7661C3" />
    <SolidColorBrush x:Key="MoonHighlightBorderBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="MoonSoftBorderBrush" Color="#45A69BD0" />
    <SolidColorBrush x:Key="MoonAmberSoftBrush" Color="#26E2A348" />
    <SolidColorBrush x:Key="MoonDangerSoftBrush" Color="#26D96A79" />

    <Style x:Key="MoonCornerOrnamentImageStyle" TargetType="{x:Type Image}">
      <Setter Property="Source" Value="/XiaobianPet;component/Assets/ui-corner-ornament.png" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="2.4"
                            ShadowDepth="0"
                            Opacity="0.62"
                            Color="#FF7661C3" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MoonKnotOrnamentImageStyle" TargetType="{x:Type Image}">
      <Setter Property="Source" Value="/XiaobianPet;component/Assets/ui-knot-divider.png" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="1.8"
                            ShadowDepth="0"
                            Opacity="0.68"
                            Color="#FF7661C3" />
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Reusable glass containers. -->
    <Style x:Key="MoonGlassShellBorderStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{StaticResource MoonShellBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MoonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="MoonGlassCardStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{StaticResource MoonCardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MoonSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="MoonSubtleCardStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{StaticResource MoonSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MoonSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="MoonStatusPillStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{StaticResource MoonTransientBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MoonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Buttons. The shared template changes border and scale only, so local
         Background values in the current windows continue to work. -->
    <Style x:Key="MoonButtonBaseStyle" TargetType="{x:Type Button}">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Background" Value="{StaticResource MoonCardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MoonSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Chrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="11"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LavenderBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LavenderBrush}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.86" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.46" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MoonPrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource MoonButtonBaseStyle}">
      <Setter Property="Background" Value="{StaticResource LavenderBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LavenderBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FF9A8AE2" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{StaticResource MoonLavenderPressedBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MoonSecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource MoonButtonBaseStyle}">
      <Setter Property="Background" Value="{StaticResource MoonCardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MoonSoftBorderBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource LavenderSoftBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#FFE5DEFA" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MoonDangerButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource MoonButtonBaseStyle}">
      <Setter Property="Background" Value="{StaticResource MoonDangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="#66D96A79" />
      <Setter Property="Foreground" Value="#FF9F3345" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource MoonDangerBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource MoonDangerBrush}" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#FFB84E60" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MoonIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource MoonSecondaryButtonStyle}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Text input. PART_ContentHost is required by TextBox. -->
    <Style x:Key="MoonTextBoxStyle" TargetType="{x:Type TextBox}">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource LavenderBrush}" />
      <Setter Property="SelectionBrush" Value="#668C76D8" />
      <Setter Property="Background" Value="{StaticResource MoonCardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MoonSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border x:Name="Chrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LavenderBrush}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MoonSubtleBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MoonSingleLineTextBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource MoonTextBoxStyle}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="10,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Focusable="False" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LavenderBrush}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="1.5" />
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MoonSubtleBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Progress bar. PART_Track and PART_Indicator are consumed by WPF. -->
    <Style x:Key="MoonProgressBarStyle" TargetType="{x:Type ProgressBar}">
      <Setter Property="Height" Value="5" />
      <Setter Property="Foreground" Value="{StaticResource LavenderBrush}" />
      <Setter Property="Background" Value="#FFE8E3F2" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ProgressBar}">
            <Grid x:Name="TemplateRoot" ClipToBounds="True" SnapsToDevicePixels="True">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Determinate" />
                  <VisualState x:Name="Indeterminate">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0" />
                      <DoubleAnimation Storyboard.TargetName="IndeterminateBar"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"
                                       Duration="0:0:0" />
                      <DoubleAnimation Storyboard.TargetName="IndeterminateTransform"
                                       Storyboard.TargetProperty="X"
                                       From="-84"
                                       To="360"
                                       Duration="0:0:1.15"
                                       RepeatBehavior="Forever" />
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="PART_Track"
                      Background="{TemplateBinding Background}"
                      CornerRadius="99" />
              <Border x:Name="PART_Indicator"
                      HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="99" />
              <Border x:Name="IndeterminateBar"
                      Width="84"
                      HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="99"
                      Opacity="0">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="IndeterminateTransform" />
                </Border.RenderTransform>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TemplateRoot" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Visual-novel navigation. PART_SelectedContentHost and ItemsPresenter
         preserve the standard TabControl selection contract. -->
    <Style x:Key="MoonTabControlStyle" TargetType="{x:Type TabControl}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource MoonSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" Columns="3" IsItemsHost="True" />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabControl}">
            <Grid SnapsToDevicePixels="True">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="#24FFFFFF"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      CornerRadius="12">
                <ItemsPresenter x:Name="HeaderPanel"
                                HorizontalAlignment="Stretch"
                                KeyboardNavigation.TabIndex="1" />
              </Border>
              <Grid Grid.Row="1"
                    Margin="4,-1,4,0"
                    IsHitTestVisible="False">
                <Border Height="1"
                        VerticalAlignment="Center"
                        Background="#568C76D8" />
                <Image Width="108"
                       Height="42"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource MoonKnotOrnamentImageStyle}" />
              </Grid>
              <Border Grid.Row="2"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="18">
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  ContentSource="SelectedContent"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MoonTabItemStyle" TargetType="{x:Type TabItem}">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MoonMutedBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <Grid>
              <Border x:Name="Chrome"
                      Margin="2,1"
                      Padding="{TemplateBinding Padding}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10">
                <ContentPresenter ContentSource="Header"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
              <Border x:Name="SelectedIndicator"
                      Height="3"
                      Margin="10,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom"
                      Background="Transparent"
                      CornerRadius="2,2,0,0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MoonLavenderHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#52FFFFFF" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="SelectedIndicator" Property="Background" Value="{StaticResource LavenderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource LavenderBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Task list cards. -->
    <Style x:Key="MoonListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="Chrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="13"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MoonLavenderHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MoonLavenderSelectedBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource MoonBorderBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LavenderBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Context menu. ItemsPresenter preserves the menu item host. -->
    <Style x:Key="MoonContextMenuStyle" TargetType="{x:Type ContextMenu}">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="220" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Grid Margin="10,14,10,10">
              <Border Background="#01000000" CornerRadius="18">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="22"
                                    ShadowDepth="5"
                                    Direction="270"
                                    Opacity="0.18"
                                    Color="#FF413955" />
                </Border.Effect>
              </Border>
              <Border Padding="0"
                      Background="{StaticResource MoonTransientBrush}"
                      BorderBrush="{StaticResource MoonBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="18"
                      SnapsToDevicePixels="True">
                <Border Margin="3"
                        Padding="3"
                        Background="#18FFFFFF"
                        BorderBrush="{StaticResource MoonHighlightBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="15">
                  <ScrollViewer CanContentScroll="True"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                  </ScrollViewer>
                </Border>
              </Border>
              <Image Width="50"
                     Height="50"
                     Margin="-6,-12,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Style="{StaticResource MoonCornerOrnamentImageStyle}"
                     Panel.ZIndex="3" />
              <Image Width="50"
                     Height="50"
                     Margin="0,-12,-6,0"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Style="{StaticResource MoonCornerOrnamentImageStyle}"
                     RenderTransformOrigin="0.5,0.5"
                     Panel.ZIndex="3">
                <Image.RenderTransform>
                  <ScaleTransform ScaleX="-1" />
                </Image.RenderTransform>
              </Image>
              <Image Width="82"
                     Height="32"
                     Margin="0,-12,0,0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Style="{StaticResource MoonKnotOrnamentImageStyle}"
                     Panel.ZIndex="4" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MoonMenuItemStyle" TargetType="{x:Type MenuItem}">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type MenuItem}">
            <Border x:Name="Chrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="11"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="18" Height="18" VerticalAlignment="Center">
                  <ContentPresenter x:Name="IconPresenter"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ContentSource="Icon" />
                  <TextBlock x:Name="CheckGlyph"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontFamily="Segoe Fluent Icons"
                             FontSize="13"
                             Foreground="{StaticResource LavenderBrush}"
                             Text="&#xE73E;"
                             Visibility="Collapsed" />
                </Grid>
                <ContentPresenter Grid.Column="1"
                                  Margin="7,0,10,0"
                                  VerticalAlignment="Center"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True" />
                <Grid Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock x:Name="GestureText"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource MoonMutedBrush}"
                             FontSize="10.5"
                             Text="{TemplateBinding InputGestureText}" />
                  <Border x:Name="ToggleTrack"
                          Width="34"
                          Height="19"
                          Background="#FFD8D3E0"
                          BorderBrush="{StaticResource MoonSoftBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Visibility="Collapsed">
                    <Ellipse x:Name="ToggleThumb"
                             Width="13"
                             Height="13"
                             Margin="2"
                             HorizontalAlignment="Left"
                             Fill="White" />
                  </Border>
                </Grid>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MoonLavenderHoverBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource MoonSoftBorderBrush}" />
              </Trigger>
              <Trigger Property="IsCheckable" Value="True">
                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ToggleTrack" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleTrack" Property="Background" Value="{StaticResource LavenderBrush}" />
                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{StaticResource LavenderBrush}" />
                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.46" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MoonMenuHeaderItemStyle"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource MoonMenuItemStyle}">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Foreground" Value="{StaticResource MoonMutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <!-- CheckBox rendered as a compact moon-glass switch. -->
    <Style x:Key="MoonSwitchCheckBoxStyle" TargetType="{x:Type CheckBox}">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MoonMutedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="SwitchTrack"
                      Width="36"
                      Height="20"
                      VerticalAlignment="Center"
                      Background="#FFD8D3E0"
                      BorderBrush="{StaticResource MoonSoftBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10">
                <Ellipse x:Name="SwitchThumb"
                         Width="14"
                         Height="14"
                         Margin="2"
                         HorizontalAlignment="Left"
                         Fill="White" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                Margin="8,0,0,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                ContentSource="Content"
                                RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource LavenderBrush}" />
                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource LavenderBrush}" />
                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource MoonAmberBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource LavenderBrush}" />
                <Setter TargetName="SwitchTrack" Property="BorderThickness" Value="1.5" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.46" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Application-wide defaults. Explicit local values in existing XAML win. -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MoonSecondaryButtonStyle}" />
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MoonTextBoxStyle}" />
    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource MoonProgressBarStyle}" />
    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource MoonTabControlStyle}" />
    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource MoonTabItemStyle}" />
    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MoonListBoxItemStyle}" />
    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource MoonContextMenuStyle}" />
    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MoonMenuItemStyle}" />
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource MoonSwitchCheckBoxStyle}" />

    <Style TargetType="{x:Type Separator}">
      <Setter Property="Margin" Value="12,5" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{StaticResource MoonSoftBorderBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Separator}">
            <Border Height="1" Background="{TemplateBinding Background}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
  </Application.Resources>
</Application>
