<Window x:Class="XiaobianPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="柯朵外观设置"
        Width="420"
        Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
  <Window.Resources>
    <Style x:Key="MoonOpacitySliderStyle" TargetType="{x:Type Slider}">
      <Setter Property="Height" Value="30" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Slider}">
            <Grid Margin="2,0">
              <Border Height="6"
                      VerticalAlignment="Center"
                      CornerRadius="3"
                      Background="#FFDCD7E7" />
              <Track x:Name="PART_Track"
                     Margin="3,0"
                     VerticalAlignment="Center"
                     Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Height="6"
                                VerticalAlignment="Center"
                                CornerRadius="3"
                                Background="{StaticResource LavenderBrush}" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Height="6"
                                VerticalAlignment="Center"
                                Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="20" Height="20" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid>
                          <Ellipse Fill="#FFFBFAFF"
                                   Stroke="{StaticResource LavenderBrush}"
                                   StrokeThickness="2" />
                          <Ellipse Width="7"
                                   Height="7"
                                   Fill="{StaticResource LavenderBrush}" />
                        </Grid>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="MoonAnimationPreviewButtonTemplate">
      <Button MinHeight="32"
              Margin="0,0,7,7"
              Padding="7,5"
              Content="{Binding DisplayName}"
              ToolTip="{Binding HelpText}"
              AutomationProperties.Name="{Binding DisplayName}"
              AutomationProperties.HelpText="{Binding HelpText}"
              Style="{StaticResource MoonSecondaryButtonStyle}"
              Click="AnimationPreviewButton_Click" />
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="10">
    <Border Margin="3"
            Style="{StaticResource MoonGlassShellBorderStyle}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22"
                          ShadowDepth="4"
                          Opacity="0.20"
                          Color="#FF3B315C" />
      </Border.Effect>

      <Border Margin="3"
              Padding="20,16,20,18"
              CornerRadius="22"
              Background="#20FFFFFF"
              BorderBrush="{StaticResource MoonHighlightBorderBrush}"
              BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Margin="7,0,3,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="34"
                    Height="34"
                    CornerRadius="17"
                    Background="#FFF1ECFB"
                    BorderBrush="#A9C9BCE7"
                    BorderThickness="1">
              <TextBlock Text="&#xE713;"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="16"
                         Foreground="{StaticResource LavenderBrush}" />
            </Border>
            <StackPanel Grid.Column="1"
                        Margin="10,0,8,0"
                        VerticalAlignment="Center">
              <TextBlock Text="外观设置"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource InkBrush}" />
              <TextBlock Text="调整界面，并直接查看角色动画"
                         Margin="0,2,0,0"
                         FontSize="10.5"
                         Foreground="{StaticResource MoonMutedBrush}" />
            </StackPanel>
            <Button Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{StaticResource MoonIconButtonStyle}"
                    ToolTip="关闭"
                    Click="CloseButton_Click">
              <TextBlock Text="&#xE8BB;"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="13" />
            </Button>
          </Grid>

          <Border Grid.Row="1"
                  Height="1"
                  Margin="4,13,4,0"
                  Background="#56B8ABC9" />

          <ScrollViewer x:Name="SettingsContentScrollViewer"
                        Grid.Row="2"
                        Margin="0,14,0,12"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False">
            <StackPanel>
              <Border Padding="15,13"
                      Style="{StaticResource MoonGlassCardStyle}">
                <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="界面整体不透明度"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" />
                <Border Grid.Column="1"
                        Padding="9,3"
                        CornerRadius="9"
                        Background="{StaticResource LavenderSoftBrush}">
                  <TextBlock x:Name="OpacityValueText"
                             Text="100%"
                             FontFamily="Segoe UI"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="#FF655489" />
                </Border>
              </Grid>

              <Slider x:Name="OpacitySlider"
                      Grid.Row="1"
                      Margin="0,8,0,0"
                      Minimum="0.60"
                      Maximum="1.00"
                      TickFrequency="0.05"
                      IsSnapToTickEnabled="True"
                      AutoToolTipPlacement="TopLeft"
                      AutoToolTipPrecision="0"
                      Style="{StaticResource MoonOpacitySliderStyle}" />

              <Grid Grid.Row="2" Margin="2,-1,2,0">
                <TextBlock Text="60%"
                           FontSize="9.5"
                           Foreground="#FF9B94A7" />
                <TextBlock Text="100%"
                           HorizontalAlignment="Right"
                           FontSize="9.5"
                           Foreground="#FF9B94A7" />
              </Grid>

              <TextBlock Grid.Row="3"
                         Margin="0,8,0,0"
                         Text="实时预览：Codex 面板、进度气泡、状态标签和右键菜单；角色本体保持清晰。"
                         TextWrapping="Wrap"
                         FontSize="10"
                         LineHeight="15"
                         Foreground="{StaticResource MoonMutedBrush}" />
                </Grid>
              </Border>

              <Border Margin="0,12,0,0"
                      Padding="15,13"
                      Style="{StaticResource MoonGlassCardStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="宠物大小"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <Border Grid.Column="1"
                            Padding="9,3"
                            CornerRadius="9"
                            Background="{StaticResource LavenderSoftBrush}">
                      <TextBlock x:Name="PetSizeValueText"
                                 Text="100%"
                                 FontFamily="Segoe UI"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="#FF655489" />
                    </Border>
                  </Grid>

                  <Slider x:Name="PetSizeSlider"
                          Grid.Row="1"
                          Margin="0,8,0,0"
                          Minimum="0.75"
                          Maximum="1.25"
                          TickFrequency="0.05"
                          IsSnapToTickEnabled="True"
                          AutomationProperties.Name="宠物大小"
                          AutomationProperties.HelpText="拖动后实时预览，范围为百分之七十五到百分之一百二十五"
                          Style="{StaticResource MoonOpacitySliderStyle}" />

                  <Grid Grid.Row="2" Margin="2,-1,2,0">
                    <TextBlock Text="75%"
                               FontSize="9.5"
                               Foreground="#FF9B94A7" />
                    <TextBlock Text="125%"
                               HorizontalAlignment="Right"
                               FontSize="9.5"
                               Foreground="#FF9B94A7" />
                  </Grid>

                  <TextBlock Grid.Row="3"
                             Margin="0,8,0,0"
                             Text="实时预览角色大小；聊天入口、进度气泡和面板会跟随角色重新定位。"
                             TextWrapping="Wrap"
                             FontSize="10"
                             LineHeight="15"
                             Foreground="{StaticResource MoonMutedBrush}" />
                </Grid>
              </Border>

              <Border x:Name="AnimationPreviewCard"
                      Margin="0,12,0,0"
                      Padding="15,13"
                      Style="{StaticResource MoonGlassCardStyle}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="动画查看"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <Border Grid.Column="1"
                            Padding="8,3"
                            CornerRadius="9"
                            Background="{StaticResource LavenderSoftBrush}">
                      <TextBlock Text="开发预览"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 Foreground="#FF655489" />
                    </Border>
                  </Grid>

                  <TextBlock Margin="0,7,0,0"
                             Text="点击后直接在桌面角色上播放一个完整序列；移动类动画只播角色帧，不改变位置。"
                             TextWrapping="Wrap"
                             FontSize="10"
                             LineHeight="15"
                             Foreground="{StaticResource MoonMutedBrush}" />

                  <StackPanel x:Name="IdleAnimationPreviewGroup" Margin="0,10,0,0">
                    <TextBlock Margin="1,0,0,5"
                               Text="待机与反馈"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF796B91" />
                    <ItemsControl x:Name="IdleAnimationPreviewItems"
                                  ItemTemplate="{StaticResource MoonAnimationPreviewButtonTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel x:Name="MovementAnimationPreviewGroup" Margin="0,2,0,0">
                    <TextBlock Margin="1,0,0,5"
                               Text="移动与恢复"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF796B91" />
                    <ItemsControl x:Name="MovementAnimationPreviewItems"
                                  ItemTemplate="{StaticResource MoonAnimationPreviewButtonTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel x:Name="DragAnimationPreviewGroup" Margin="0,2,0,0">
                    <TextBlock Margin="1,0,0,5"
                               Text="拖拽"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF796B91" />
                    <ItemsControl x:Name="DragAnimationPreviewItems"
                                  ItemTemplate="{StaticResource MoonAnimationPreviewButtonTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>

                  <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AnimationPreviewStatusText"
                               Margin="1,0,8,0"
                               VerticalAlignment="Center"
                               Text="选择一个动画开始查看"
                               TextWrapping="Wrap"
                               FontSize="10"
                               Foreground="{StaticResource MoonMutedBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="StopAnimationPreviewButton"
                            Grid.Column="1"
                            MinHeight="32"
                            Padding="10,5"
                            Content="停止预览"
                            IsEnabled="False"
                            Style="{StaticResource MoonSecondaryButtonStyle}"
                            Click="StopAnimationPreviewButton_Click" />
                  </Grid>

                  <TextBlock Margin="1,8,0,0"
                             Text="弹脑门按钮是纯素材预览，不代表真实独占交互；真正单击角色时才会启用仅抓取可打断的交互规则。招手与任务状态目前复用基础待机，因此不重复列出。预览不会播放台词，也不会保存状态。"
                             TextWrapping="Wrap"
                             FontSize="9.5"
                             LineHeight="14"
                             Foreground="#FF8E879B" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <TextBlock x:Name="ErrorText"
                     Grid.Row="3"
                     Margin="5,-4,5,7"
                     Text="设置保存失败，请稍后重试。"
                     TextWrapping="Wrap"
                     FontSize="10.5"
                     Foreground="#FFC55467"
                     Visibility="Collapsed" />

          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="恢复默认"
                    Padding="12,6"
                    Style="{StaticResource MoonSecondaryButtonStyle}"
                    Click="ResetButton_Click" />
            <Button Grid.Column="1"
                    Content="预览气泡"
                    Margin="8,0,0,0"
                    MinWidth="88"
                    Padding="8,6"
                    HorizontalAlignment="Left"
                    Style="{StaticResource MoonSecondaryButtonStyle}"
                    Click="PreviewBubbleButton_Click" />
            <Button x:Name="CancelButton"
                    Grid.Column="2"
                    Content="取消"
                    Margin="0,0,8,0"
                    Padding="13,6"
                    Style="{StaticResource MoonSecondaryButtonStyle}"
                    Click="CancelButton_Click" />
            <Button x:Name="SaveButton"
                    Grid.Column="3"
                    Content="保存"
                    Padding="15,6"
                    Style="{StaticResource MoonPrimaryButtonStyle}"
                    Click="SaveButton_Click" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Image Width="44"
           Height="44"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Style="{StaticResource MoonCornerOrnamentImageStyle}"
           IsHitTestVisible="False" />
    <Image Width="44"
           Height="44"
           HorizontalAlignment="Right"
           VerticalAlignment="Bottom"
           Style="{StaticResource MoonCornerOrnamentImageStyle}"
           RenderTransformOrigin="0.5,0.5"
           IsHitTestVisible="False">
      <Image.RenderTransform>
        <ScaleTransform ScaleX="-1" ScaleY="-1" />
      </Image.RenderTransform>
    </Image>
  </Grid>
</Window>
