<Window x:Class="XiaobianPet.ChatOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打开柯朵聊天"
        Width="60"
        Height="60"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid Background="{x:Null}">
    <Button x:Name="ChatButton"
            Width="48"
            Height="48"
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Focusable="False"
            FocusVisualStyle="{x:Null}"
            ToolTip="打开聊天"
            AutomationProperties.Name="打开柯朵聊天"
            Click="ChatButton_Click">
      <Button.Template>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid x:Name="OrbVisual"
                Width="48"
                Height="48"
                RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Border x:Name="Chrome"
                    Background="{StaticResource MoonTransientBrush}"
                    BorderBrush="{StaticResource MoonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    SnapsToDevicePixels="True">
              <Border.Effect>
                <DropShadowEffect BlurRadius="14"
                                  ShadowDepth="2"
                                  Direction="270"
                                  Opacity="0.18"
                                  Color="#796E5E8E" />
              </Border.Effect>

              <Grid>
                <Border Margin="3"
                        Background="#18FFFFFF"
                        BorderBrush="{StaticResource MoonHighlightBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20" />
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="18"
                           FontWeight="Normal"
                           Foreground="#FF74638F"
                           Text="&#xE8F2;" />
              </Grid>
            </Border>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome"
                      Property="Background"
                      Value="{StaticResource LavenderSoftBrush}" />
              <Setter TargetName="Chrome"
                      Property="BorderBrush"
                      Value="{StaticResource LavenderBrush}" />
              <Setter TargetName="OrbVisual" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome"
                      Property="Background"
                      Value="#FFE5DEFA" />
              <Setter TargetName="OrbVisual" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="OrbVisual" Property="Opacity" Value="0.46" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </Grid>
</Window>
